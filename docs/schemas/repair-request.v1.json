{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/tibatechapp-ship-it/MIZAN/main/docs/schemas/repair-request.v1.json",
  "title": "MIZAN repair request (repair-request.v1)",
  "description": "Structured handoff from MIZAN to a coding agent. MIZAN never applies edits: the agent works in an isolated branch/worktree, presents diff plus test results, and a human approves the merge. Insufficient evidence never produces a request.",
  "type": "object",
  "required": [
    "schema",
    "finding_id",
    "evidence",
    "proposed_fix",
    "constraints",
    "verification",
    "confidence",
    "human_review_required"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "repair-request.v1"},
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "description": "The finding's stable fingerprint (partialFingerprints from SARIF, or the deterministic SHA-256 fallback of tool|rule|file|line|message)."
    },
    "evidence": {
      "type": "object",
      "required": ["tool", "rule_id", "file", "line", "message"],
      "additionalProperties": false,
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "message": {"type": "string", "minLength": 1},
        "tool_level": {
          "description": "The producing tool's own level, carried verbatim; may be null when the tool declared none."
        }
      }
    },
    "proposed_fix": {
      "type": "object",
      "required": ["kind", "auto_appliable", "summary"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "review-suggestion"},
        "auto_appliable": {"const": false},
        "summary": {"type": "string"}
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["what", "how"],
        "additionalProperties": false,
        "properties": {
          "what": {"type": "string", "minLength": 1},
          "how": {"type": "string", "minLength": 1}
        }
      }
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "human_review_required": {"const": true}
  }
}
